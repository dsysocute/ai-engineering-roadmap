    /** 去空白、转小写后做包含匹配 */
    private static String hitWord(String[] words, String text) {
        String s = text.replaceAll("[ \\t\\u3000]", "").toLowerCase();
        for (String w : words) {
            if (s.contains(w)) {
                return w;
            }
        }
        return null;
    }

    private static String promptBlockedWord(String text) {
        return hitWord(PROMPT_BLOCK, text);
    }

    private static String abuseBlockedWord(String text) {
        return hitWord(ABUSE_BLOCK, text);
    }

